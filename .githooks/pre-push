#!/bin/sh
# Every lane hosted CI runs, run here first. One lane at a time behind a lock,
# which is also this machine's memory rule. Bypassing this hook is not a workflow.
set -e

root="$(git rev-parse --show-toplevel)"
zig="$root/.local/zig/current/zig"
[ -x "$zig" ] || zig="$zig.exe"
[ -x "$zig" ] || zig=zig

gate_needed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: refusing direct push to main; open a pull request and squash-merge on green" >&2
    exit 1
  fi
  case "$remote_ref" in refs/heads/*) gate_needed=1 ;; *) continue ;; esac
  case "$remote_sha" in
    *[!0]*) "$zig" build gate -- --log "$remote_sha..$local_sha" ;;
    *) "$zig" build gate -- --log "$local_sha --not --remotes=origin" ;;
  esac
done

[ "$gate_needed" = 1 ] || exit 0
cd "$root"

lock="$root/.zig-cache/pre-push.lock"
mkdir -p "$root/.zig-cache"
if ! mkdir "$lock" 2>/dev/null; then
  echo "pre-push: another gate run holds the lock at $lock; wait for it, or remove that directory if no run is alive" >&2
  exit 1
fi
trap 'rmdir "$lock" 2>/dev/null || true' EXIT INT TERM

step() {
  name="$1"; shift
  printf 'pre-push: %s\n' "$name" >&2
  start=$(date +%s)
  if ! "$@"; then
    echo "pre-push: FAILED at $name" >&2
    echo "pre-push: re-run just this lane with: $*" >&2
    exit 1
  fi
  printf 'pre-push: %s ok (%ss)\n' "$name" "$(( $(date +%s) - start ))" >&2
}

changed="$(git diff --name-only "$(git merge-base origin/main HEAD 2>/dev/null || echo HEAD~1)" HEAD 2>/dev/null || echo unknown)"
docs_only=1
for f in $changed; do
  case "$f" in *.md) ;; *) docs_only=0 ;; esac
done
[ -n "$changed" ] || docs_only=0

step "gate suite" "$zig" build ci
if [ "$docs_only" = 1 ]; then
  echo "pre-push: prose-only push, build lanes skipped" >&2
  exit 0
fi
step "wasm" "$zig" build wasm -Doptimize=ReleaseFast
step "web sdk" sh -c 'cd sdk/ts && bun install --silent && bun run build:js && bun run typecheck && bun test'
step "android cross-build" "$zig" build android -Doptimize=ReleaseFast
echo "pre-push: every hosted lane passed locally" >&2
